# Copy to backend/.env and adjust. Never commit the real .env.

# Gemma 4 through Ollama (running in the same Codespace)
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=600

# Frontend team: set MOCK_GEMMA=1 to get instant fake answers without Gemma
MOCK_GEMMA=0
MOCK_DELAY_SECONDS=2

# Reference library (verified cases). Lives outside git.
REFERENCE_DIR=data/reference
MAX_REFERENCE_CASES=2
SEND_REFERENCE_IMAGES=1

# Protects POST /api/references. Pick any long random string.
ADMIN_TOKEN=change-me

MAX_UPLOAD_MB=25
CORS_ORIGINS=*
